# Lukas Archery Works — environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.

# --- Chatbot LLM (ADR-0002: provider-agnostic, OpenAI-compatible) ---
# The chatbot talks to any OpenAI-compatible chat-completions endpoint.
# Switching paid -> free -> local is config-only, no code change.
#
# Defaults (used when unset): OpenRouter + openai/gpt-oss-120b.
#   Paid (OpenRouter):  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Local (Ollama):     LLM_BASE_URL=http://localhost:11434/v1
#   Local (LM Studio):  LLM_BASE_URL=http://localhost:1234/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b
# Required for hosted providers; may be left empty for a keyless local server.
LLM_API_KEY=

# --- Chatbot rate limiting (Upstash Redis over REST) ---
# Per-IP abuse/cost protection for /api/chat. When BOTH values are unset the
# limiter fails open (no limiting) — convenient for local dev. Set both in
# production. Uses the REST API (no SDK) so the app stays host-portable (ADR-0001).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Window tuning (optional; defaults shown): max requests per IP per window.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
